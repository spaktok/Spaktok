# ============================================================================
# Spaktok Development Environment - Multi-stage Optimized Dockerfile
# ============================================================================
# Stage 1: Flutter Web Builder
# ============================================================================
FROM ubuntu:22.04 AS flutter-builder

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    xz-utils \
    zip \
    libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

# Install Flutter SDK
ENV FLUTTER_HOME=/opt/flutter
ENV PATH="${FLUTTER_HOME}/bin:${PATH}"

RUN git clone https://github.com/flutter/flutter.git -b stable ${FLUTTER_HOME} \
    && flutter config --no-analytics \
    && flutter precache --web \
    && flutter doctor

# Set working directory
WORKDIR /app

# Copy Flutter project files for caching
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

# Copy the entire Flutter project
COPY . .

# Build Flutter web
RUN flutter build web --release

# ============================================================================
# Stage 2: Production Runtime with Node.js & Firebase
# ============================================================================
FROM node:20-slim

# Install Firebase CLI and utilities
RUN npm install -g firebase-tools http-server

# Create app directory
WORKDIR /app

# Copy built Flutter web app from builder stage
COPY --from=flutter-builder /app/build/web ./web

# Copy Firebase configuration
COPY firebase.json .firebaserc ./
COPY firestore.rules firestore.indexes.json storage.rules ./
COPY functions/ ./functions/

# Install function dependencies
WORKDIR /app/functions
RUN npm ci --only=production

# Return to app root
WORKDIR /app

# Expose ports
# 8080: Flutter web app
# 5001: Firebase Functions
# 8080: Firestore emulator
# 9099: Firebase Auth emulator
EXPOSE 8080 5001 9099

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

# Start Firebase emulators and serve web app
CMD ["sh", "-c", "firebase emulators:start --only auth,firestore,functions,hosting --project spaktok-dev & http-server ./web -p 8080"]
