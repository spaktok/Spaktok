# Backend Environment Variables Template
# Copy this file to .env and fill in your values

# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://spaktok-mongo:27017/spaktok

# PostgreSQL
POSTGRES_HOST=spaktok-postgres
POSTGRES_PORT=5432
POSTGRES_USER=spaktok
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=spaktok

# Redis
REDIS_URL=redis://spaktok-redis:6379

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Agora
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# Chat (if using Easemob/Agora Chat)
CHAT_APP_KEY=
CHAT_ORG_NAME=
CHAT_APP_NAME=
CHAT_CLIENT_ID=
CHAT_CLIENT_SECRET=

# Cloudflare R2 (S3-compatible object storage)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_ACCOUNT_ID=b62ed7e1cf0e1dc886f363573bad4bdb
CLOUDFLARE_R2_BUCKET=spaktok-media
CLOUDFLARE_R2_ENDPOINT=https://b62ed7e1cf0e1dc886f363573bad4bdb.r2.cloudflarestorage.com

# Cloudflare Stream (video hosting)
CLOUDFLARE_STREAM_API_TOKEN=your_stream_api_token
CLOUDFLARE_STREAM_ACCOUNT_ID=b62ed7e1cf0e1dc886f363573bad4bdb

# Cloudflare Images (optional - for image optimization)
CLOUDFLARE_IMAGES_API_TOKEN=your_images_api_token
CLOUDFLARE_IMAGES_ACCOUNT_ID=b62ed7e1cf0e1dc886f363573bad4bdb
CLOUDFLARE_IMAGES_ACCOUNT_HASH=your_account_hash

# JWT Secret
JWT_SECRET=your_jwt_secret_min_32_chars

# Node Environment
NODE_ENV=development
