# shellcheck shell=sh
# shellcheck disable=SC2034
# ===================================================================
# Spaktok Environment Variables Template
# ===================================================================
# IMPORTANT: Do NOT commit real secrets to the repository!
# Use CI/CD secret stores (GitHub Secrets, Firebase Config, etc.)
# ===================================================================

# ===================================================================
# Firebase Configuration
# ===================================================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Service Account (path to JSON file)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Firebase Deploy Token (for CI/CD)
FIREBASE_TOKEN=your_firebase_deploy_token

# ===================================================================
# Agora Video/Voice Configuration
# ===================================================================
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# ===================================================================
# Stripe Payment Configuration
# ===================================================================
# Test Keys (Development)
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Production Keys (uncomment for production)
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_key
# STRIPE_SECRET_KEY=sk_live_your_live_key
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# ===================================================================
# Docker Configuration
# ===================================================================
# WARNING: Never commit real tokens! Use GitHub Secrets instead
DOCKER_USERNAME=your_docker_username
DOCKER_TOKEN=your_docker_access_token

# ===================================================================
# Backend/Node.js Configuration
# ===================================================================
NODE_ENV=development
PORT=3000
HOST=localhost

# Database (if using external DB)
DATABASE_URL=postgresql://user:password@localhost:5432/spaktok

# Redis (if using for caching)
REDIS_URL=redis://localhost:6379

# ===================================================================
# Chat/IM Provider (if using external service)
# ===================================================================
CHAT_APP_KEY=your_chat_app_key
CHAT_ORG_NAME=your_org
CHAT_APP_NAME=your_app

# ===================================================================
# Monitoring & Analytics
# ===================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ANALYTICS_KEY=your_analytics_key

# ===================================================================
# Development Tools
# ===================================================================
ANDROID_SDK_ROOT=/path/to/android/sdk
JAVA_HOME=/path/to/java
FLUTTER_ROOT=/path/to/flutter

# ===================================================================
# CI/CD Secrets (Set in GitHub Repository Settings)
# ===================================================================
# CODECOV_TOKEN=your_codecov_token
# AGORA_APP_ID=<from secrets>
# STRIPE_PUBLISHABLE_KEY=<from secrets>
# DOCKER_USERNAME=<from secrets>
# DOCKER_TOKEN=<from secrets>
# FIREBASE_TOKEN=<from secrets>
# FIREBASE_PROJECT_ID=<from secrets>
