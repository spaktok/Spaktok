# Example environment variables file for Spaktok
# Do NOT commit real secrets to the repository. Use your CI/CD secret store or
# set these in your hosting environment (Firebase functions config, GCP Secret
# Manager, Docker secrets, etc.).

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase service account (either set GOOGLE_APPLICATION_CREDENTIALS to a
# file path, or provide the JSON as a secret in your environment)
GOOGLE_APPLICATION_CREDENTIALS=

# Agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Chat / IM provider
CHAT_APP_KEY=
CHAT_ORG_NAME=
CHAT_APP_NAME=

# Docker registry (use CI secrets instead of hard-coding)
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PAT=

# Payment, analytics, other third-party keys
SENTRY_DSN=
ANALYTICS_KEY=
# ===================================================================
# Firebase Configuration - Spaktok
# ===================================================================

# Firebase Web Config (من Firebase Console)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ===================================================================
# Agora Configuration
# ===================================================================

AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate

# ===================================================================
# Stripe Configuration
# ===================================================================

# Test Keys (للتطوير)
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_your_test_key
STRIPE_SECRET_KEY_TEST=sk_test_your_test_key

# Production Keys (للإنتاج)
STRIPE_PUBLISHABLE_KEY_PROD=pk_live_your_live_key
STRIPE_SECRET_KEY_PROD=sk_live_your_live_key

# ===================================================================
# Docker Configuration
# ===================================================================

DOCKER_USERNAME=yanalalghezawi
DOCKER_TOKEN=dckr_pat_URROUZ-d8_DfQPZxQTrF_d1bb9g

# ===================================================================
# Backend Configuration
# ===================================================================

NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/spaktok
REDIS_URL=redis://localhost:6379

# ===================================================================
# Android Studio Configuration
# ===================================================================

ANDROID_SDK_ROOT=/path/to/android/sdk
JAVA_HOME=/path/to/java

# ===================================================================
# Flutter Configuration
# ===================================================================

FLUTTER_ROOT=/path/to/flutter
