version: v1.5.0
ignore:
  javascript/HardcodedNonCryptoSecret:
    - web/firebase-config.js:
        reason: Firebase client API keys and config are public by design. Not a secret.
        expires: 2026-01-01T00:00:00.000Z
    - web/firebase-public-config.json:
        reason: Firebase client API keys are public by design. Standard client configuration.
        expires: 2026-01-01T00:00:00.000Z
    - lib/core/firebase_options.dart:
        reason: Firebase client API keys (public). Generated by 'flutterfire configure' command.
        expires: 2026-01-01T00:00:00.000Z
    - android/app/google-services.json:
        reason: Firebase client configuration file (public). Generated automatically.
        expires: 2026-01-01T00:00:00.000Z
    - macos/Runner/GoogleService-Info.plist:
        reason: Firebase client configuration (public). Generated automatically for macOS build.
        expires: 2026-01-01T00:00:00.000Z
    - ios/Runner/GoogleService-Info.plist:
        reason: Firebase client configuration (public). Generated automatically for iOS build.
        expires: 2026-01-01T00:00:00.000Z
  javascript/Sqli:
    - functions/src/stripe.js:
        reason: No SQL used; this file uses Firestore transactions. False positive.
        expires: 2026-01-01T00:00:00.000Z
